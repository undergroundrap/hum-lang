module examples.probes.word_count

task count_word(words: List Text, wanted: Text) -> UInt {
  why:
    count exact matches without changing the input words

  ensures:
    result == list_count(words, wanted)

  cost:
    time: O(words)
    space: O(1)
    check: warn

  does:
    change count: UInt = 0

    for each word in words {
      if word == wanted {
        set count = count + 1
      }
    }

    return count
}

task count_hum_literal() -> UInt {
  why:
    demonstrate reusable counting with a fixed input

  ensures:
    result == list_count(["hum", "lang", "hum", "agent"], "hum")

  does:
    return count_word(["hum", "lang", "hum", "agent"], "hum")
}

test count_word counts exact matches unit {
  why:
    name the reusable counting contract as a test obligation

  covers:
    count_word ensures result == list_count(words, wanted)

  does:
    expect count_word(["hum", "lang", "hum"], "hum") returns 2
}

test count_hum_literal counts matching words unit {
  why:
    pin word count probe behavior

  covers:
    count_hum_literal ensures result == list_count(["hum", "lang", "hum", "agent"], "hum")

  does:
    expect count_hum_literal() returns 2
}
