module programs.foreign

app foreign {
  uses:
    stdout.write
  starts with:
    run_tool

  task run_tool -> Result Unit, OutputError {
    uses:
      stdout.write
    fails when:
      output is denied
    allocates:
      callee-defined allocation behavior
    does:
      let message = "Hello, world!"
      let written = try stdout_write(message)
      return written
  }
}
