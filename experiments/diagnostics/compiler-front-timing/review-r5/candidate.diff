+  . $CallerProbeFile
+  Remove-Item -LiteralPath $CallerProbeFile -Force -ErrorAction SilentlyContinue
+  $env:HUM_TIMING_CONTROLS_NORECURSE = '1'
+  try {
+    # All-pass suite succeeds through the shared caller (this threw
+    # "timing ledger controls failed with exit code 5" before the fix).
+    $AllPassThrew = $false
+    $AllPassMessage = ''
+    try { Invoke-RepoScript 'timing ledger controls (shared-caller probe)' 'test_timing_ledger.ps1' }
+    catch { $AllPassThrew = $true; $AllPassMessage = $_.Exception.Message }
+    Assert-Control (-not $AllPassThrew) 'all-pass suite succeeds through the shared caller'
+    if ($AllPassThrew) { Write-Host "  caller threw: $AllPassMessage" }
+
+    # Deliberate setup failure still fails through the shared caller.
+    # (The anchor is concatenated so this source never contains it literally;
+    # the real occurrence is then unique.)
+    $SetupSabotage = Join-Path $ToolsDir 'test_timing_ledger.setup-sabotage.tmp.ps1'
+    $SuiteText = [IO.File]::ReadAllText((Join-Path $ToolsDir 'test_timing_ledger.ps1'))
+    $SetupAnchor = "Write-Host 'control 1: initialize truncates a stale ledger" + " and opens a versioned session'"
+    if (([regex]::Matches($SuiteText, [regex]::Escape($SetupAnchor))).Count -ne 1) { throw 'sabotage anchor not unique' }
+    [IO.File]::WriteAllText($SetupSabotage,
+      $SuiteText.Replace($SetupAnchor, "throw 'deliberate setup failure probe'`n$SetupAnchor"),
+      [Text.UTF8Encoding]::new($false))
+    $SetupThrew = $false
+    try { Invoke-RepoScript 'setup sabotage probe' 'test_timing_ledger.setup-sabotage.tmp.ps1' }
+    catch { $SetupThrew = $true }
+    Assert-Control $SetupThrew 'a deliberate setup failure still fails through the shared caller'
+
+    # Deliberate assertion failure still fails: the suite records the
+    # failure, exits 1, and the caller throws (the success-path
+    # $LASTEXITCODE reset above is unreachable after exit 1). The failing
+    # assertion is injected at the top level before control 1, so it fires
+    # exactly once.
+    $AssertSabotage = Join-Path $ToolsDir 'test_timing_ledger.assert-sabotage.tmp.ps1'
+    [IO.File]::WriteAllText($AssertSabotage,
+      $SuiteText.Replace($SetupAnchor, ("Assert-Control `$false 'deliberate sabotage probe (must fail)'`n$SetupAnchor")),
+      [Text.UTF8Encoding]::new($false))
+    $AssertThrew = $false
+    $AssertMessage = ''
+    try { Invoke-RepoScript 'assertion sabotage probe' 'test_timing_ledger.assert-sabotage.tmp.ps1' }
+    catch { $AssertThrew = $true; $AssertMessage = $_.Exception.Message }
+    Assert-Control ($AssertThrew -and $AssertMessage -match 'failed with exit code 1') 'a deliberate assertion failure still fails through the shared caller'
+  } finally {
+    Remove-Item Env:HUM_TIMING_CONTROLS_NORECURSE -ErrorAction SilentlyContinue
+    Remove-Item -LiteralPath (Join-Path $ToolsDir 'test_timing_ledger.setup-sabotage.tmp.ps1') -Force -ErrorAction SilentlyContinue
+    Remove-Item -LiteralPath (Join-Path $ToolsDir 'test_timing_ledger.assert-sabotage.tmp.ps1') -Force -ErrorAction SilentlyContinue
+  }
+} else {
+  Write-Host '  (shared-caller probe skipped: recursion guard active)'
+}
+
+Remove-Item -LiteralPath $WorkDir -Recurse -Force -ErrorAction SilentlyContinue
+Write-Host "timing controls: $($script:Passed) passed, $($script:Failed) failed"
+if ($script:Failed -gt 0) { exit 1 }
+# The shared caller (Invoke-RepoScript) fails the group on a nonzero
+# $LASTEXITCODE. Expected native failures above (exit 3/5 probes) must not
+# leak a false failure status once the suite itself passed. Genuine
+# failures already terminated via exit 1 above, so this reset runs only on
+# the success path; the generic caller is untouched.
+$global:LASTEXITCODE = 0
