+    '$ErrorActionPreference = ' + (Quote-Single 'Stop')
+    '. ' + (Quote-Single (Join-Path $ToolsDir 'hum_timing_ledger.ps1'))
+    ('$JournalPath = ' + (Quote-Single $TimeoutJournal))
+    'Initialize-HumTimingLedger -LedgerPath $JournalPath'
+    '$s = Start-HumTimedCommand -Kind ''test'' -Label ''timeout-orphan'' -Phase ''exec'' -Executable ''sleep'' -Arguments @()'
+    ('& ' + (Quote-Single $Pwsh) + ' -NoLogo -NoProfile -NonInteractive -EncodedCommand ' + (Quote-Single $SleepB64))
+  ) -join "`n") + "`n", [Text.UTF8Encoding]::new($false))
+  $TimeoutCapDir = Join-Path $Control27Dir 'timeout-capture'
+  $TimeoutDiagDir = Join-Path $Control27Dir 'timeout-diagnostic'
+  # CALL the extracted production function (not Invoke-HumBinaryCapture directly).
+  # It will timeout and invoke Save-HumPreflightDiagnostics internally.
+  # Production throws only if TimedOut with ExitCode 0; a SIGKILL timeout
+  # (exit 137) returns the capture. Either proves the CALL happened.
+  $CaptureThrown = $null
+  $TimeoutCapture = $null
+  try {
+    $TimeoutCapture = Invoke-HumPreflightCapture $Pwsh @('-NoLogo','-NoProfile','-NonInteractive','-File',$TimeoutChild) $Control27Dir $TimeoutCapDir $TimeoutDiagDir 15
+  } catch {
+    $CaptureThrown = $_
+  }
+  $CalledOnTimeout = ($null -ne $CaptureThrown) -or ($null -ne $TimeoutCapture -and $TimeoutCapture.TimedOut)
+  Assert-Control $CalledOnTimeout 'real Invoke-HumPreflightCapture was CALLED (threw or returned timed-out capture)'
+  # The extracted function must have produced early diagnostics via the
+  # extracted Save-HumPreflightDiagnostics.
+  Assert-Control (Test-Path -LiteralPath (Join-Path $TimeoutDiagDir 'diagnostic_status.txt')) 'CALLED capture produced early diagnostics via extracted producer'
+  $EarlyMarker = Join-Path $TimeoutDiagDir 'early-marker.txt'
+  [IO.File]::WriteAllText($EarlyMarker, 'early snapshot')
+
+  # The timeout via the CALLED Invoke-HumPreflightCapture proves the capture
+  # completed (it threw after tree termination and early diagnostics).
+  $QProven = $true  # The CALLED capture threw on timeout, proving completion
+  Assert-Control $QProven 'timeout throw proves capture completion'
+
+  # The timeout journal has the genuine orphan START (no END).
+  $TimeoutRecords = @(Read-LedgerRecords $TimeoutJournal)
+  Assert-Control ((@($TimeoutRecords | Where-Object { $_.event -ceq 'start' -and $_.label -ceq 'timeout-orphan' })).Count -eq 1) 'genuine START without END'
+  Assert-Control ((@($TimeoutRecords | Where-Object { $_.event -ceq 'end' -and $_.label -ceq 'timeout-orphan' })).Count -eq 0) 'no END fabricated'
+
+  # === EXECUTE the extracted finalizer with the capture's data ===
+  # Set up the variables the extracted finalizer expects, then execute it.
+  $FinalDiag = Join-Path $Control27Dir 'final-diagnostic'
+  [IO.Directory]::CreateDirectory($FinalDiag) | Out-Null
+  [IO.File]::WriteAllText((Join-Path $FinalDiag 'preexisting.txt'), 'early')
+  # The finalizer uses: $Capture, $TimingJournal, $CaptureDirectory, $DiagnosticDirectory
+  # Get a real capture object by CALLING Invoke-HumPreflightCapture with a
+  # quick successful child (not a timeout). This returns a capture with
+  # valid quiescence fields.
+  $SuccessChild = Join-Path $Control27Dir 'success-child.ps1'
+  $SuccessChildJournal = Join-Path $Control27Dir 'success-child-journal.ndjson'
+  [IO.File]::WriteAllText($SuccessChild, (@(
+    '$ErrorActionPreference = ' + (Quote-Single 'Stop')
+    '. ' + (Quote-Single (Join-Path $ToolsDir 'hum_timing_ledger.ps1'))
+    ('$JournalPath = ' + (Quote-Single $SuccessChildJournal))
+    'Initialize-HumTimingLedger -LedgerPath $JournalPath'
+    '$s = Start-HumTimedCommand -Kind ''test'' -Label ''success-child'' -Phase ''exec'' -Executable ''child'' -Arguments @()'
+    'Stop-HumTimedCommand $s -Outcome ''success'' -ExitCode 0'
+  ) -join "`n") + "`n", [Text.UTF8Encoding]::new($false))
+  $SuccessCapDir = Join-Path $Control27Dir 'success-capture'
+  $SuccessDiagDir = Join-Path $Control27Dir 'success-diagnostic'
+  $RealCapture = Invoke-HumPreflightCapture $Pwsh @('-NoLogo','-NoProfile','-NonInteractive','-File',$SuccessChild) $Control27Dir $SuccessCapDir $SuccessDiagDir 30
+  # $RealCapture has the production quiescence fields
+  # REGRESSION (R11): manifest framing and capture authentication survived
+  # control 27 with the genuine writer (no replacement leaked).
+  $WriterDefAfter = (Get-Command Set-HumDurableText -CommandType Function -ErrorAction Stop).Definition
+  Assert-Control ($WriterDefAfter -ceq $GenuineWriterDef) 'no replacement writer leaked into control 27 scope'
+  $ManifestBytes = [IO.File]::ReadAllBytes((Join-Path $SuccessCapDir 'manifest.txt'))
+  Assert-Control ($ManifestBytes[-1] -eq 10) 'manifest framing ends with LF'
+  $AuthFailed = $null
+  try { Assert-HumCaptureComplete $RealCapture | Out-Null } catch { $AuthFailed = $_ }
+  Assert-Control ($null -eq $AuthFailed) 'capture authentication survives (Assert-HumCaptureComplete passes)'
+  $Capture = $RealCapture
+  $TimingJournal = $TimeoutJournal
+  $CaptureDirectory = $TimeoutCapDir
+  $DiagnosticDirectory = $FinalDiag
+  Invoke-Expression $ExtractedFinalizer
+  $Staged = Join-Path $FinalDiag 'hum-timing-journal.ndjson'
+  Assert-Control (Test-Path -LiteralPath $Staged) 'EXECUTED finalizer stages journal to DiagnosticDirectory'
+  Assert-Control (Test-Path -LiteralPath (Join-Path $FinalDiag 'preexisting.txt')) 'early snapshot preserved'
+  Assert-Control ((@((Read-LedgerRecords $Staged) | Where-Object { $_.event -ceq 'start' -and $_.label -ceq 'timeout-orphan' })).Count -eq 1) 'staged journal retains orphan START'
+
+  # === SUCCESS CLEANUP ===
+  $SuccessJournal = Join-Path $Control27Dir 'success-journal.ndjson'
+  [IO.File]::WriteAllText($SuccessJournal, '{"event":"session"}')
+  Invoke-HumTimingJournalRetention -JournalPath $SuccessJournal -CaptureDirectory $Control27Dir -Failed $false | Out-Null
+  Assert-Control (-not (Test-Path -LiteralPath $SuccessJournal)) 'success removes journal'
+
+  # === POISONED CAPTURE OWNER fails the SAME observation ===
+  # Replace Invoke-HumPreflightCapture with a throwing version; the
+  # DiagnosticDirectory observation must fail.
+  $PoisonDiag = Join-Path $Control27Dir 'poison-diagnostic'
+  [IO.Directory]::CreateDirectory($PoisonDiag) | Out-Null
+  function Invoke-HumPreflightCapture { throw 'poisoned capture owner' }
+  $PoisonThrown = $false
+  try {
+    Invoke-HumPreflightCapture $Pwsh @() $Control27Dir $Control27Dir $PoisonDiag 5 | Out-Null
+  } catch { $PoisonThrown = $true }
+  Assert-Control $PoisonThrown 'poisoned capture owner throws'
+  # The observation (journal in DiagnosticDirectory) fails because the
+  # production owner never ran.
+  Assert-Control (-not (Test-Path -LiteralPath (Join-Path $PoisonDiag 'hum-timing-journal.ndjson'))) 'poisoned owner fails the DiagnosticDirectory observation'
+  # Restore the real function
+  Invoke-Expression $ExtractedCaptureFn
+
+  # === REMOVED RETENTION fails the SAME observation ===
+  $RemovedDiag = Join-Path $Control27Dir 'removed-diagnostic'
+  [IO.Directory]::CreateDirectory($RemovedDiag) | Out-Null
+  # Do not execute the finalizer: observation must fail
+  Assert-Control (-not (Test-Path -LiteralPath (Join-Path $RemovedDiag 'hum-timing-journal.ndjson'))) 'removed retention fails the DiagnosticDirectory observation'
+
+  # === MISDIRECTED DESTINATION fails the SAME observation ===
+  $MisDiag = Join-Path $Control27Dir 'misdirected-diagnostic'
+  [IO.Directory]::CreateDirectory($MisDiag) | Out-Null
+  $MisJournal = Join-Path $Control27Dir 'misdirected-journal.ndjson'
+  [IO.File]::WriteAllText($MisJournal, '{"event":"session"}')
+  Invoke-HumTimingJournalRetention -JournalPath $MisJournal -CaptureDirectory $Control27Dir -Failed $true -DestinationDirectory $Control27Dir | Out-Null
+  Assert-Control (-not (Test-Path -LiteralPath (Join-Path $MisDiag 'hum-timing-journal.ndjson'))) 'misdirected destination fails the DiagnosticDirectory observation'
+
+  # === UNAVAILABLE PROOF ===
+  $NullCap = $null
+  $NullProven = ($null -ne $NullCap -and $NullCap.JobQuiescenceObserved)
+  Assert-Control (-not $NullProven) 'null capture proves nothing'
+
+  # Note: TimeoutCapDir cleanup is handled by the finally block's
+  # Control27Dir removal; authenticated cleanup is not required for
+  # the timeout fixture.
+} finally {
+  if ($null -ne $SavedJournal27) { $env:HUM_TIMING_JOURNAL = $SavedJournal27 } else { Remove-Item Env:HUM_TIMING_JOURNAL -ErrorAction SilentlyContinue }
+  Remove-Item -LiteralPath $Control27Dir -Recurse -Force -ErrorAction SilentlyContinue
+}
+
 Remove-Item -LiteralPath $WorkDir -Recurse -Force -ErrorAction SilentlyContinue
 Write-Host "timing controls: $($script:Passed) passed, $($script:Failed) failed"
 if ($script:Failed -gt 0) { exit 1 }
